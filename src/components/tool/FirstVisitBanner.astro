---
// Slim, dismissible onboarding banner shown above the tool on a visitor's first
// visit. Prerendered hidden; src/tool/main.ts unhides it when the "seen" flag
// (localStorage only — no tracking, same as the saved color/recents) is absent.
import Lucide from '../icons/Lucide.astro';
import { ONBOARDING_STEPS } from '../../content/steps';
---

<aside class="relative overflow-hidden rounded-xl border p-4 sm:p-5" data-banner hidden>
  <div class="flex items-start justify-between gap-3">
    <div class="font-mono text-2xs font-medium text-accent-ink">New here? Three quick steps</div>
    <button
      type="button"
      data-banner-dismiss
      aria-label="Dismiss"
      class="-mt-1 -mr-1 rounded-md p-1 text-muted-foreground transition-colors hover:text-foreground"
    >
      <Lucide name="x" class="h-4 w-4" />
    </button>
  </div>

  <ol class="mt-3 grid gap-3 sm:grid-cols-3">
    {
      ONBOARDING_STEPS.map((step, i) => (
        <li class="flex items-start gap-2.5">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-live/10 font-mono text-xs font-medium text-accent-ink">
            {i + 1}
          </span>
          <div>
            <p class="text-sm leading-snug font-medium text-foreground">{step.title}</p>
            <p class="text-xs leading-relaxed text-muted-foreground">{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</aside>
