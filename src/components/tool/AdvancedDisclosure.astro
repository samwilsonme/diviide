---
// Shared chrome for a sidebar section's "Advanced" disclosure: a <details>
// with the mono summary row and a chevron that flips while open, identical
// between the Color and Label sections. The caller keeps its own runtime hook
// (the data-* attribute src/tool/* queries).
import Lucide from '../icons/Lucide.astro';

interface Props {
  /**
   * The data-* hook the runtime queries, e.g. 'data-label-advanced'. Omit it for
   * a disclosure no script drives: the color picker's opens and closes on its
   * own, so an attribute there would be markup nothing reads.
   */
  dataAttr?: string;
}
const { dataAttr } = Astro.props;
const hook = dataAttr ? { [dataAttr]: true } : {};
---

{
  /* data-disabled (set by the caller's runtime, e.g. the label section while its
    input is empty) dims the disclosure and blocks interaction. */
}
<details
  {...hook}
  class="group data-[disabled]:pointer-events-none data-[disabled]:opacity-50 data-[disabled]:select-none"
>
  <summary
    class="flex cursor-pointer list-none items-center justify-end gap-1 font-mono text-2xs text-muted-foreground/80 transition-colors select-none hover:text-muted-foreground [&::-webkit-details-marker]:hidden"
  >
    <span>Advanced</span>
    <Lucide name="chevron-down" class="h-3.5 w-3.5 transition-transform group-open:rotate-180" />
  </summary>
  <div class="mt-3 space-y-3">
    <slot />
  </div>
</details>
