{
  "name": "diviide",
  "private": true,
  "version": "1.0.0",
  "description": "Bookmark separators in any color to organize your bookmarks bar. Pick a color, choose from 182 separator icons, and drag one straight onto your bar. Free and open source.",
  "keywords": [
    "bookmarks",
    "bookmark-separators",
    "bookmark-bar",
    "favicon",
    "astro",
    "chrome"
  ],
  "homepage": "https://divii.de",
  "bugs": "https://github.com/samwilsonme/diviide/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/samwilsonme/diviide.git"
  },
  "author": "Sam Wilson (https://github.com/samwilsonme)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:favicons": "node scripts/verify-favicons.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
